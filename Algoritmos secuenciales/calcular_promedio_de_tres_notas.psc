Proceso calcular_promedio_de_tres_notas
	Definir nota1, nota2, nota3, promedio Como Real;
	Escribir "Por favor ingrese su primer nota";
	Leer nota1;
	Escribir "Por favor ingrese su segunda nota";
	Leer nota2;
	Escribir "Por favor ingrese su tercera nota";
	Leer nota3;
	promedio <- (nota1+nota2+nota3)/3;
	Escribir "Su nota promedio es: ", promedio;
	
FinProceso
