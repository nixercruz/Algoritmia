Proceso calcular_el_area_de_un_triangulo
	Definir base, altura, area Como Real;
	Escribir "Por favor digite el valor de la base de el triangulo";
	Leer base;
	Escribir "Por favor digite el valor de la altura de el triangulo";
	Leer altura;
	area <- base*altura/2;
	Escribir "El area del triangulo es: ", area;
	
FinProceso
