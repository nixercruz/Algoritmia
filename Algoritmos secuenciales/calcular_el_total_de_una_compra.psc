Proceso calcular_el_total_de_una_compra
	Definir cantidad, precio, total Como Real;
	Escribir "Por favor digite la cantidad de productos";
	Leer cantidad;
	Escribir "Por favor digite el precio del producto";
	Leer precio;
	total <- precio*cantidad;
	Escribir "El valor total de sus productos es: ", total;
	
FinProceso
