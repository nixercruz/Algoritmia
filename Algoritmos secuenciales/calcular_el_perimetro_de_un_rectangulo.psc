Proceso calcular_el_perimetro_de_un_rectangulo
	Definir base, altura, perimetro Como Real;
	Escribir "Por favor ingrese la base del rectángulo";
	Leer base;
	Escribir "Por favor ingrese la altura del rectángulo";
	Leer altura;
	perimetro <- (base+altura)*2;
	Escribir "EL perímetro de tu rectángulo es: ",perimetro;
	
	
FinProceso
