Proceso calcular_la_edad_a_partir_del_ano_de_nacimiento
	Definir anodenacimiento, anoactual, edad Como Real;
	Escribir "Por favor digite su año de nacimiento";
	leer anodenacimiento;
	Escribir "Por favor digite el año actual";
	Leer anoactual;
	edad <- anoactual-anodenacimiento;
	Escribir "Su edad es: ", edad;
	
FinProceso
