Proceso convertir_celsius_a_farenheit
	Definir gradoscelsius, gradosfarenheit Como Real;
	Escribir "por favor ingrese su valor en grados celsius";
	Leer gradoscelsius;
	gradosfarenheit <- gradoscelsius * 1.8 + 32;
	Escribir "Sus grados celsius son en farenheit son: ", gradosfarenheit ;
	
FinProceso
