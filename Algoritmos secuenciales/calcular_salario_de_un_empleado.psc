Algoritmo calcular_salario_de_un_empleado
	Definir salario, valordehora, horastrabajadas Como Real;
	Escribir "Por favor digite su número de horas trabajadas";
	Leer horastrabajadas;
	Escribir "Por favor digite el pago por hora";
	Leer valordehora;
	salario <- horastrabajadas*valordehora;
	Escribir "Su salario total es: ", salario;
	
FinAlgoritmo
